# Anchor Consultants — environment variables
#
# Copy to `.env` for local work, or set these in your host's dashboard.
# `.env` is gitignored and must never be committed.
#
# Every variable below is optional. With none of them set the site builds and
# runs, and the contact and CV forms validate and submit — they simply report
# honestly that nothing was delivered. Nothing here changes any code path
# other than the ones described.

# ─────────────────────────────────────────────────────────────
# Mail delivery — used only by src/pages/api/contact.ts
# ─────────────────────────────────────────────────────────────
# Delivery switches on when HOST, USER and PASSWORD are all present.
# Until then submissions are logged to the server console and the visitor is
# told plainly that the message was not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Envelope sender. Must be an address the SMTP account is allowed to send as.
# Defaults to SMTP_USER. The visitor's own address goes in Reply-To, never in
# From, because sending as them fails SPF and DMARC on most providers.
SMTP_FROM=

# Where enquiries and CV submissions are delivered.
# Defaults to the address in src/data/site.ts.
CONTACT_TO=

# ─────────────────────────────────────────────────────────────
# reCAPTCHA v3
# ─────────────────────────────────────────────────────────────
# Both keys come from https://www.google.com/recaptcha/admin (choose v3).
# Register the production domain, and localhost if you want to test locally.
#
# The site key is public and is inlined into the browser bundle, which is why
# it carries the PUBLIC_ prefix Astro requires. The secret is server-only.
#
# Leave both blank and reCAPTCHA is fully inert: the third-party script is
# never loaded and the endpoint skips verification. Set BOTH or NEITHER —
# a secret with no site key would reject every submission for a missing token.
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
