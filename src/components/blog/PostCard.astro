---
import { getSite } from '../../data/get-site';
import { postAuthor, postCategories } from '../../lib/blog';
import CmsImage from '../ui/CmsImage.astro';
import type { CollectionEntry } from 'astro:content';
import Icon from '../ui/Icon.astro';

/**
 * Blog index item.
 *
 * Measured from the original at 1440:
 *   item 856 wide; featured image 750x500 sitting above the content block
 *   content block 40px padding, `0 0 70px rgba(0,0,0,0.08)` shadow
 *   meta 16px/26px #777, author then date, 34px apart
 *   title 26px/700/36px #1C1E22, 15px below the meta
 *   excerpt 16px/26px #777, 10px below the title
 *   items 40px apart
 *
 * The original links the author to a WordPress author archive. There is one
 * author and no such route here, so the name is plain text rather than a
 * link that would 404.
 */
interface Props {
  /**
   * Heading level for the card title. Defaults to 2, which is right on the blog
   * index where nothing encloses the list. Inside a section that already has its
   * own h2 — "Related reading" — pass 3, or the card titles become siblings of
   * the section heading rather than children of it.
   */
  headingLevel?: 2 | 3;
  post: CollectionEntry<'posts'>;
}
const { post, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const { title, excerpt, coverImage, publishedAt } = post.data;

// Author and categories arrive as strings from markdown and as resolved
// documents from Sanity; `src/lib/blog.ts` flattens both to one shape.
const site = await getSite();
const author = postAuthor(post.data.author, site.name);
const categories = postCategories(post.data);
const primary = categories[0];

const href = `/blog/${post.id}/`;
const dateFmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<article
  class="reveal"
  data-post
  data-category={primary?.slug ?? ''}
  data-month={`${publishedAt.getUTCFullYear()}-${String(publishedAt.getUTCMonth() + 1).padStart(2, '0')}`}
  data-search={`${title} ${excerpt} ${categories.map((c) => c.title).join(' ')}`.toLowerCase()}
>
  {
    coverImage && (
      <a href={href} tabindex="-1" aria-hidden="true" class="block">
        <CmsImage
          src={coverImage}
          alt=""
          aria-hidden="true"
          widths={[375, 750, 1500]}
          sizes="(min-width: 1200px) 750px, 100vw"
          class="h-auto w-full max-w-[750px]"
          loading="lazy"
        />
      </a>
    )
  }

  <div class="card-body">
    <p class="text-body flex flex-wrap items-center gap-x-[34px] gap-y-1 text-base leading-[26px]">
      <span class="flex items-center gap-2">
        <Icon name="user" size={16} class="shrink-0" />
        {author.name}
      </span>
      <span class="flex items-center gap-2">
        <Icon name="calendar" size={16} class="shrink-0" />
        <time datetime={publishedAt.toISOString()}>{dateFmt.format(publishedAt)}</time>
      </span>
    </p>

    <Heading class="mt-[15px] text-[26px] leading-[36px] font-bold [overflow-wrap:anywhere]">
      <a href={href} class="text-ink hover:text-navy transition-colors">{title}</a>
    </Heading>

    <p class="text-body mt-[10px] text-base leading-[26px] [overflow-wrap:anywhere]">{excerpt}</p>
  </div>
</article>

<style>
  .card-body {
    padding: 40px;
    box-shadow: 0 0 70px rgb(0 0 0 / 0.08);
    background: #fff;
  }
  @media (max-width: 767px) {
    .card-body {
      padding: 30px 25px;
    }
  }
</style>
