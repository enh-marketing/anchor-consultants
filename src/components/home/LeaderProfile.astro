---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import type { LeaderProfileBlock } from '../../lib/sections';
import CmsImage from '../ui/CmsImage.astro';
import PortableText from '../shared/PortableText.astro';
import bg from '../../assets/images/services/carousel-bg.jpg';

// One section on the original (top 3661, 762px tall) holding both the leader
// card and the appointment CTA, over services.jpg with a #436B88 overlay
// at 0.9 — the same treatment as the services carousel.
//
//   h2 "Our Leader" centred, white, 60px/700 on a 70px line box
//   card 1140x488 at x=150, white, 5px radius, 10px padding
//   portrait 533x468 at x=177
//   role 16px/500 #084876, name 60px/700 #1C1E22, bio 16px/400 #777 (530px wide)
//   CTA copy 30px/700 white on a 40px line box, centred
//
// The original's "Get An Appointment" link is #777 on this dark overlay,
// roughly 1.9:1 (audit defect #27). Rendered white here, which keeps the
// same understated text-link treatment while being readable.
//
// The leader comes from the `team` collection, so the name, role, portrait and
// bio are all editable. The bio emphasises names, tenure and institutions in
// bold, which is why it is rich text: the emphasis is part of the content, not
// styling applied to a fixed string. Those `<strong>` runs are coloured by the
// `.leader-bio` rule below rather than a class on each one, since a CMS cannot
// attach utility classes.
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const leader = team[0];

// Alt text precedence. In Sanity the alt is authored on the image itself, which
// is the right place for it — the person editing the portrait is the person who
// should describe it — so that wins. `photoAlt` is the markdown fallback's
// frontmatter equivalent. The name is the last resort: it identifies the
// subject, which beats an empty alt on a portrait that is not decorative.
const photo = leader?.data.photo;
const photoAlt =
  (photo && 'alt' in photo ? photo.alt : undefined) || leader?.data.photoAlt || leader?.data.name;

// Markdown fallback renders the file body; Sanity sends Portable Text.
const leaderBio = leader && Array.isArray(leader.data.bio) ? leader.data.bio : null;
const BioContent = leader && !leaderBio ? (await render(leader)).Content : null;

interface Props {
  block?: LeaderProfileBlock;
}
const { block } = Astro.props;

const title = block?.title ?? 'Our Leader';
const ctaHeading =
  block?.ctaHeading ?? 'You can request an appointment to discuss your financing options.';

// Both actions open a dialog rather than navigating, so the configurable part
// is the label and which dialog it opens. The dialog ids are a fixed list in
// the schema: a free-text field here would let an editor point a button at a
// dialog that does not exist.
const actions = (block?.actions ?? []).flatMap((a) =>
  a.label && a.dialog ? [{ label: a.label, dialog: a.dialog }] : [],
);
const resolvedActions = actions.length
  ? actions
  : [
      { label: 'Get An Appointment', dialog: 'contact-dialog' },
      { label: 'Apply For Job', dialog: 'cv-dialog' },
    ];
---

<section class="relative isolate overflow-hidden pt-[30px]">
  <Image
    src={bg}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    loading="lazy"
    widths={[768, 1440]}
    sizes="100vw"
  />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[#436B88] opacity-90"></div>

  <div class="container-bs">
    <SectionHeading title={title} onDark align="center" />

    <!-- Leader card -->
    <!-- The card is 1140px wide on the original, inset 78px inside the 1296px
         container rather than filling it. -->
    <div class="reveal mx-auto mt-[30px] max-w-[1140px] rounded-[5px] bg-white p-[10px]">
      <div
        class="grid items-center gap-8 lg:grid-cols-[533px_minmax(0,1fr)] lg:gap-[30px] lg:pl-[17px]"
      >
        {
          leader?.data.photo && (
            <CmsImage
              src={leader.data.photo}
              alt={photoAlt ?? ''}
              class="mx-auto h-auto w-[533px] max-w-full"
              loading="lazy"
              widths={[533, 1066]}
              sizes="(min-width: 992px) 533px, 90vw"
            />
          )
        }

        <div class="px-4 pb-8 lg:px-0 lg:pb-0">
          <p class="text-navy text-base leading-[21px] font-medium">{leader?.data.role}</p>
          <h3 class="text-section text-ink -mt-[6px] font-bold">{leader?.data.name}</h3>
          <div class="leader-bio text-body mt-[20px] max-w-[530px] text-base leading-[26px]">
            {leaderBio ? <PortableText value={leaderBio} /> : BioContent && <BioContent />}
          </div>
        </div>
      </div>
    </div>

    <!-- Appointment CTA -->
    <div class="pt-[30px] pb-[20px] text-center">
      <p class="text-[30px] leading-[40px] font-bold text-white">
        {ctaHeading}
      </p>
      <!-- The original puts two Popup Maker triggers side by side here,
           as plain 14px/700 text with no icon: "Get An Appointment"
           spanning 581-723 and "Apply For Job" 765-859, so a 42px gap
           centred in the container. The original colours them #777 over a
           dark photograph, which fails contrast (defect #27); white here. -->
      <div class="mt-[30px] flex flex-wrap items-center justify-center gap-x-[42px] gap-y-3">
        {
          resolvedActions.map((action) => (
            <button
              type="button"
              data-dialog-open={action.dialog}
              class="text-small font-bold text-white underline-offset-4 transition-colors hover:underline"
            >
              {action.label}
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* The bio's <strong> runs carried `text-ink-strong` as a utility class. A CMS
     cannot attach one, so the colour lives here instead — same result. */
  .leader-bio :global(strong) {
    color: var(--color-ink-strong);
  }
  /* The bio is a single paragraph; the renderer wraps it in <p>, which must not
     add the margin the blog prose style gives paragraphs. */
  .leader-bio :global(p) {
    margin: 0;
  }
</style>
