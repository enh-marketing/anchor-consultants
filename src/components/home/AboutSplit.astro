---
import CmsImage from '../ui/CmsImage.astro';
import PortableText from '../shared/PortableText.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import img1 from '../../assets/images/about/split-2.jpg';
import img2 from '../../assets/images/about/split-1.jpg';
import { altProp, resolveLink, type AboutSplitBlock } from '../../lib/sections';

// Measured from the original at 1440:
//   section 790px tall, padding 110px / 30px
//   two 420x420 images, the second offset +170 right and +210 down
//   eyebrow at y=1503, h2 at y=1546 (60px/700, 70px line box)
//   body at y=1716, 16px/400 #777 on a 26px line box, 640px wide
//   CTA at y=2023, 202x60 — note the background is teal #0E6C90 here,
//   not the navy used by every other button on the page.

interface Props {
  block?: AboutSplitBlock;
}
const { block } = Astro.props;

const eyebrow = block?.eyebrow ?? 'About Us';
const title = block?.title ?? 'Real-World Banking Experience';
const cta = resolveLink(block?.cta, { label: 'Discover More', href: '/about/' });

// The shipped copy is one paragraph whose three parts are separated by two
// <br>s, which is markup rather than structure. Portable Text would render it
// as three <p> elements instead, so the two are not interchangeable: the CMS
// path gets its own `.about-body` rule below that reproduces the same rhythm
// (a 26px gap equals the empty line box the double <br> used to create).
//
// Keeping the original markup as the fallback means the no-CMS build stays
// byte-for-byte what it was, and the CMS path is verified against the same
// measurement rather than assumed equivalent.
const cmsBody = Array.isArray(block?.body) ? block.body : null;

const images = (block?.images ?? []).flatMap((entry) =>
  entry.image ? [{ image: entry.image, alt: entry.alt }] : [],
);
const [first, second] = images.length === 2 ? images : [];
const firstImage = first ?? {
  image: img1,
  alt: 'Anchor advisers discussing mortgage options with a client',
};
const secondImage = second ?? {
  image: img2,
  alt: 'Client reviewing property financing paperwork with an adviser',
};
---

<section class="overflow-hidden pt-[110px] pb-[30px]">
  <!-- Elementor sections use their own gutters, narrower than the theme's
       Bootstrap container: two 660px columns flush to the 1320px container
       edge, each inset 10px. Header and footer keep .container-bs. -->
  <div class="mx-auto w-full max-w-[1320px] px-3 lg:px-0">
    <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-0 lg:[&>*]:pl-[10px]">
      <!-- Overlapping image pair. On the original the two 420x420 images sit
           at x=63 / x=233 and y=1544 / y=1754, i.e. the second offset +170
           right and +210 down, inside a column padded 10px top and bottom. -->
      <div
        class="reveal relative mx-auto w-full max-w-[590px] lg:mx-0 lg:max-w-[600px] lg:py-[10px]"
      >
        <CmsImage
          src={firstImage.image}
          {...altProp(firstImage.alt)}
          class="h-auto w-[71.186%]"
          loading="lazy"
          widths={[300, 420, 840]}
          sizes="(min-width: 992px) 420px, 71vw"
        />
        <CmsImage
          src={secondImage.image}
          {...altProp(secondImage.alt)}
          class="-mt-[35.593%] ml-[28.814%] h-auto w-[71.186%]"
          loading="lazy"
          widths={[300, 420, 840]}
          sizes="(min-width: 992px) 420px, 71vw"
        />
      </div>

      <!-- Copy -->
      <!-- The original's text block overflows its column upward: the copy
           starts 31px above the section's padding box. Reproduced directly
           rather than by imitating Elementor's flex-overflow quirk. -->
      <div class="reveal lg:-mt-[31px]" data-reveal-delay="0.1">
        <SectionHeading eyebrow={eyebrow} title={title} />

        {
          cmsBody ? (
            <div class="prose-para text-body mt-[30px] max-w-[640px] text-base leading-[26px]">
              <PortableText value={cmsBody} />
            </div>
          ) : (
            <p class="text-body mt-[30px] max-w-[640px] text-base leading-[26px]">
              <>
                <b class="text-ink-strong">
                  Anchor Mortgage Consultants UAE-Expert Mortgage Advisory &amp; Home Loans
                </b>
                <br />
                <br />
              </>
              <>
                <b class="text-ink-strong">
                  Secure Your Ideal Home Loan &amp; Property Financing in Dubai, Abu Dhabi, and
                  Across the UAE
                </b>
                <br />
                <br />
              </>
              Anchor Mortgage Consultants UAE is a{' '}
              <b class="text-ink-strong">leading mortgage advisory firm</b> dedicated to helping
              residents, expatriates, and property investors navigate the UAE mortgage market with
              confidence. Whether you are buying your first home, investing in commercial property,
              or looking to refinance your existing mortgage, our expert consultants provide
              <b class="text-ink-strong">tailored mortgage solutions</b> that meet your financial
              goals.
            </p>
          )
        }

        <!-- The original points this at /~anchor/about/, a leftover
             subdirectory path that redirects (audit defect #6). -->
        <Button href={cta.href} icon="chevron-right" class="!bg-teal hover:!bg-navy mt-[47px]">
          {cta.label}
        </Button>
      </div>
    </div>
  </div>
</section>
