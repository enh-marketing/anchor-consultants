---
import CmsImage from '../ui/CmsImage.astro';
import Icon from '../ui/Icon.astro';
import tile1 from '../../assets/images/features/tile-1.jpg';
import tile2 from '../../assets/images/features/tile-2.jpg';
import tile3 from '../../assets/images/features/tile-3.jpg';
import type { ServiceHighlightRowBlock } from '../../lib/sections';

// Measured from the original at 1440:
//   full-bleed 3-column row, 381px tall, each column 475px wide
//   padding 70px 60px per column
//   photographic background per column, cover / centred
//   title 30px/700 white on a 35px line box
//   body 16px/400 #F0EDED on a 26px line box
//   link "Read More" 16px/500 #F3F3F3
//
// Each column carries an Elementor background overlay, which is what makes
// the text legible over the photography:
//   tiles 1 and 3  #1C1E22 at 0.7, rising to 0.8 on hover
//   tile 2         #0E6C90 at 0.8  (this, not the photo, is why it reads blue)
//
// The original sets the tile body to #F0EDED and the link to #F3F3F3. Over
// the teal tile that measures 5.76:1 against the mean pixel behind the text
// but only 3.97:1 against the brightest, under the 4.5:1 AA floor. Pure white
// takes the worst pixel to 4.62:1 and is indistinguishable at this lightness.
// Tiles 1 and 3 pass either way; changed together for consistency.
// with a 0.3s transition.

const defaultTiles = [
  {
    title: 'Home Loan',
    body: 'Finance of villas, apartments and even off-plan properties for salaried and self-employed individuals',
    href: '/services/mortgage-solutions/',
    image: tile1,
    overlay: 'bg-ink',
    overlayOpacity: 'opacity-70 group-hover:opacity-80',
  },
  {
    title: 'Commercial Finance',
    body: 'Asset backed financing solutions for Self-Employed Individuals, UAE based entities such as SMEs, Large and Mid-Corporates, Trusts, Offshore Companies, etc.',
    href: '/services/commercial-finances/',
    image: tile2,
    // The middle tile reads blue because of this teal overlay, not the photo.
    overlay: 'bg-teal',
    overlayOpacity: 'opacity-80',
  },
  {
    title: 'Construction & Developer Finance',
    body: 'Finance against commercial properties, construction and rental backed finance',
    href: '/services/construction-developer-finance/',
    image: tile3,
    overlay: 'bg-ink',
    overlayOpacity: 'opacity-70 group-hover:opacity-80',
  },
];

interface Props {
  block?: ServiceHighlightRowBlock;
}
const { block } = Astro.props;

// The overlay is a named variant, not a colour field: the middle tile reads
// blue because of a teal overlay at 0.8, and letting an editor pick any colour
// would break the contrast that was measured for this section.
const OVERLAYS = {
  ink: { overlay: 'bg-ink', overlayOpacity: 'opacity-70 group-hover:opacity-80' },
  teal: { overlay: 'bg-teal', overlayOpacity: 'opacity-80' },
} as const;

const cmsTiles = (block?.tiles ?? []).flatMap((tile) =>
  tile.title && tile.href && tile.image
    ? [
        {
          title: tile.title,
          body: tile.body ?? '',
          href: tile.href,
          image: tile.image,
          ...OVERLAYS[tile.overlay ?? 'ink'],
        },
      ]
    : [],
);
const tiles = cmsTiles.length ? cmsTiles : defaultTiles;
const label = block?.label ?? 'Financing at a glance';
---

<section aria-label={label} class="grid md:grid-cols-3">
  {
    tiles.map((tile) => (
      <article class="group relative isolate flex min-h-[381px] flex-col justify-start px-8 py-16 lg:px-[60px] lg:py-[70px]">
        <CmsImage
          src={tile.image}
          alt=""
          aria-hidden="true"
          class="absolute inset-0 -z-20 h-full w-full object-cover"
          loading="lazy"
          widths={[480, 960]}
          sizes="(min-width: 768px) 33vw, 100vw"
        />
        <div
          aria-hidden="true"
          class:list={[
            'absolute inset-0 -z-10 transition-opacity duration-300',
            tile.overlay,
            tile.overlayOpacity,
          ]}
        />

        {/* h2, not h3: this row has no section heading above it, so h3 would
            skip a level straight from the page h1. Styling is explicit, so the
            tag change is invisible. */}
        <h2 class="text-display leading-[35px] font-bold text-white">{tile.title}</h2>
        <p class="mt-5 text-base leading-[26px] text-white">{tile.body}</p>
        <a
          href={tile.href}
          class="mt-7 inline-flex items-center gap-2 text-base font-medium text-white/95 transition-colors hover:text-white"
        >
          {/* Three tiles each linked "Read More", which is meaningless out of
              context to a screen reader listing links, and to a crawler. The
              visible text is unchanged; the destination is named for anyone
              who cannot see which tile it sits in. */}
          Read More<span class="sr-only"> about {tile.title}</span>
          <Icon name="chevron-right" size={14} />
        </a>
      </article>
    ))
  }
</section>
