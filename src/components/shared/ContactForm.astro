---
/**
 * Contact form, used both on the contact page and inside the modal.
 *
 * Measured from the original: fields 60px tall, 1px #EDEDED, no radius,
 * 14px text, 20px left padding, an icon on the right; name and message
 * full width, email and phone side by side with a 23px gap; submit 60px
 * tall, #084876, 14px/500, 3px radius.
 *
 * Fixes carried in:
 *   #15 — the original has no labels at all and uses `type="text"` for
 *         email and phone. Real labels are present here (visually hidden,
 *         so the placeholder-only look is unchanged) with correct types.
 *   #16 — errors are announced through a live region.
 */
interface Props {
  /** `page` renders inside the grey panel; `modal` is more compact. */
  variant?: 'page' | 'modal';
  id: string;
  class?: string;
}
const { variant = 'page', id, class: className = '' } = Astro.props;
const compact = variant === 'modal';
---

<form
  class:list={['contact-form', compact && 'is-compact', className]}
  id={id}
  method="post"
  action="/api/contact"
  novalidate
>
  <input type="hidden" name="kind" value="contact" />

  <!-- Honeypot. Off-screen rather than display:none, which some bots skip. -->
  <div class="sr-only-focusable absolute" aria-hidden="true">
    <label for={`${id}-website`}>Leave this field empty</label>
    <input id={`${id}-website`} type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class:list={['grid gap-[25px]', compact && 'gap-4']}>
    <div class="field">
      <label for={`${id}-name`} class="sr-only-focusable absolute">Full name</label>
      <div class="relative">
        <input
          id={`${id}-name`}
          name="name"
          type="text"
          autocomplete="name"
          placeholder="Full Name"
          required
          aria-describedby={`${id}-name-err`}
        />
        <svg class="field-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="6.5" r="3.2" stroke="currentColor" stroke-width="1.4"></circle>
          <path d="M3.5 17c.6-3.2 3.3-5 6.5-5s5.9 1.8 6.5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
      </div>
      <p class="err" id={`${id}-name-err`}></p>
    </div>

    <div class:list={['grid gap-[25px] sm:grid-cols-2 sm:gap-x-[23px]', compact && 'gap-4']}>
      <div class="field">
        <label for={`${id}-email`} class="sr-only-focusable absolute">Email address</label>
        <div class="relative">
          <input
            id={`${id}-email`}
            name="email"
            type="email"
            autocomplete="email"
            placeholder="Email Address"
            required
            aria-describedby={`${id}-email-err`}
          />
          <svg class="field-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect x="2" y="4" width="16" height="12" rx="1.6" stroke="currentColor" stroke-width="1.4"></rect>
            <path d="m2.6 5.4 6.6 4.5a1.4 1.4 0 0 0 1.6 0l6.6-4.5" stroke="currentColor" stroke-width="1.4"></path>
          </svg>
        </div>
        <p class="err" id={`${id}-email-err`}></p>
      </div>

      <div class="field">
        <label for={`${id}-phone`} class="sr-only-focusable absolute">Phone number</label>
        <div class="relative">
          <input
            id={`${id}-phone`}
            name="phone"
            type="tel"
            autocomplete="tel"
            placeholder="Phone Number"
            required
            aria-describedby={`${id}-phone-err`}
          />
          <svg class="field-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5.5 2.5h2.2l1.1 3-1.5 1a9 9 0 0 0 4.2 4.2l1-1.5 3 1.1v2.2a1.5 1.5 0 0 1-1.6 1.5A12.4 12.4 0 0 1 2.5 4.1 1.5 1.5 0 0 1 4 2.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
          </svg>
        </div>
        <p class="err" id={`${id}-phone-err`}></p>
      </div>
    </div>

    <div class="field">
      <label for={`${id}-message`} class="sr-only-focusable absolute">Your question</label>
      <div class="relative">
        <textarea
          id={`${id}-message`}
          name="message"
          rows={compact ? 4 : 7}
          placeholder="Question"
          aria-describedby={`${id}-message-err`}></textarea>
        <svg class="field-icon field-icon-top" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M13.5 3.2 16.8 6.5 7.6 15.7l-4 .7.7-4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
        </svg>
      </div>
      <p class="err" id={`${id}-message-err`}></p>
    </div>

    <button type="submit" class="submit">
      <span class="label">Submit Now</span>
      <svg class="h-3 w-3.5" viewBox="0 0 14 12" fill="none" aria-hidden="true">
        <path d="M1 6h12m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>

    <!-- Result. Assertive so a failure is announced immediately. -->
    <p class="status" role="status" aria-live="polite"></p>
  </div>
</form>

<style>
  .contact-form input[type='text'],
  .contact-form input[type='email'],
  .contact-form input[type='tel'],
  .contact-form textarea {
    width: 100%;
    background: #fff;
    border: 1px solid #ededed;
    border-radius: 0;
    font-size: 14px;
    color: #1c1e22;
    padding: 1px 44px 1px 20px;
  }
  .contact-form input[type='text'],
  .contact-form input[type='email'],
  .contact-form input[type='tel'] {
    height: 60px;
  }
  .contact-form textarea {
    display: block;
    padding: 15px 44px 2px 20px;
    height: 220px;
    min-height: 60px;
    resize: vertical;
  }
  .contact-form.is-compact textarea {
    height: 140px;
  }
  .contact-form.is-compact .submit {
    margin-top: 0;
  }
  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: #777;
  }
  .contact-form input:focus-visible,
  .contact-form textarea:focus-visible {
    outline: 2px solid #084876;
    outline-offset: -1px;
  }

  .field-icon {
    position: absolute;
    right: 20px;
    top: 50%;
    width: 16px;
    height: 16px;
    transform: translateY(-50%);
    color: #777;
    pointer-events: none;
  }
  .field-icon-top {
    top: 22px;
    transform: none;
  }

  /* Invalid state is driven by the script, not :invalid, so errors only
     appear once the visitor has actually tried the field. */
  .contact-form [aria-invalid='true'] {
    border-color: #ec1113;
  }

  .err {
    display: none;
    margin-top: 6px;
    font-size: 14px;
    line-height: 20px;
    color: #ec1113;
  }
  .err:not(:empty) {
    display: block;
  }

  .submit {
    /* The grid gap is 25px; the original leaves 33px above the button. */
    margin-top: 8px;
    display: inline-flex;
    height: 60px;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 3px;
    background: #084876;
    font-size: 14px;
    font-weight: 500;
    color: #fff;
    transition: background-color 0.2s;
  }
  .submit:hover {
    background: #0a5488;
  }
  .submit[disabled] {
    opacity: 0.7;
    cursor: progress;
  }

  .status {
    display: none;
    font-size: 14px;
    line-height: 22px;
  }
  .status:not(:empty) {
    display: block;
  }
  .status[data-state='ok'] {
    color: #1b6b50;
  }
  .status[data-state='error'] {
    color: #ec1113;
  }
</style>

<script>
  import { validateContact, hasErrors, type FieldName } from '../../lib/forms';

  const RECAPTCHA_SITE_KEY = ''; // TODO(client): reCAPTCHA v3 site key

  document.querySelectorAll<HTMLFormElement>('form.contact-form').forEach((form) => {
    const field = (n: string) => form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${n}"]`);
    const errBox = (n: string) => form.querySelector<HTMLElement>(`#${CSS.escape(form.id)}-${n}-err`);
    const status = form.querySelector<HTMLElement>('.status')!;
    const submit = form.querySelector<HTMLButtonElement>('.submit')!;

    const values = () => ({
      name: field('name')?.value ?? '',
      email: field('email')?.value ?? '',
      phone: field('phone')?.value ?? '',
      message: field('message')?.value ?? '',
    });

    const paint = (errors: Partial<Record<FieldName, string>>, only?: string) => {
      (['name', 'email', 'phone', 'message'] as const).forEach((n) => {
        if (only && only !== n) return;
        const el = field(n);
        const box = errBox(n);
        const msg = errors[n] ?? '';
        if (box) box.textContent = msg;
        el?.setAttribute('aria-invalid', msg ? 'true' : 'false');
      });
    };

    // Validate a field once it has been left, then live as it is corrected.
    (['name', 'email', 'phone', 'message'] as const).forEach((n) => {
      const el = field(n);
      if (!el) return;
      el.addEventListener('blur', () => paint(validateContact(values()), n));
      el.addEventListener('input', () => {
        if (el.getAttribute('aria-invalid') === 'true') paint(validateContact(values()), n);
      });
    });

    const token = async (): Promise<string | undefined> => {
      const g = (window as unknown as { grecaptcha?: { ready: (cb: () => void) => void; execute: (k: string, o: { action: string }) => Promise<string> } }).grecaptcha;
      if (!RECAPTCHA_SITE_KEY || !g) return undefined;
      return new Promise((resolve) => {
        g.ready(async () => resolve(await g.execute(RECAPTCHA_SITE_KEY, { action: 'contact' })));
      });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errors = validateContact(values());
      paint(errors);
      status.textContent = '';
      status.removeAttribute('data-state');

      if (hasErrors(errors)) {
        const first = (['name', 'email', 'phone', 'message'] as const).find((n) => errors[n]);
        if (first) field(first)?.focus();
        status.dataset['state'] = 'error';
        status.textContent = 'Please check the highlighted fields.';
        return;
      }

      submit.disabled = true;
      const original = submit.querySelector('.label')!.textContent;
      submit.querySelector('.label')!.textContent = 'Sending…';

      try {
        const body = new FormData(form);
        const t = await token();
        if (t) body.set('token', t);
        const res = await fetch(form.action, { method: 'POST', body });
        const data = await res.json();

        if (!res.ok || !data.ok) {
          if (data.errors) paint(data.errors);
          status.dataset['state'] = 'error';
          status.textContent = data.reason ?? 'Something went wrong. Please try again, or call us.';
        } else if (data.delivered === false) {
          // Never claim a message was sent when it was not.
          status.dataset['state'] = 'error';
          status.textContent =
            'Email delivery is not configured on this environment yet, so this message was not sent. Please call or email us directly.';
        } else {
          status.dataset['state'] = 'ok';
          status.textContent = 'Thank you. We will be in touch shortly.';
          form.reset();
          paint({});
        }
      } catch {
        status.dataset['state'] = 'error';
        status.textContent = 'We could not reach the server. Please try again, or call us.';
      } finally {
        submit.disabled = false;
        submit.querySelector('.label')!.textContent = original;
      }
    });
  });
</script>
