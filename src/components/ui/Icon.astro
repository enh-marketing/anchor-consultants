---
/**
 * Inline SVG icon set.
 *
 * Replaces Font Awesome (220 KB) and the theme's custom `flaticon` font,
 * which between them shipped on every page for roughly a dozen glyphs.
 */
export type IconName =
  | 'envelope'
  | 'phone'
  /** A desk phone, for a landline. Distinct from `phone`, which is a handset. */
  | 'phone-landline'
  | 'map-pin'
  | 'whatsapp'
  | 'arrow-up'
  | 'arrow-right'
  | 'chevron-right'
  | 'menu'
  | 'close'
  | 'plus'
  | 'minus'
  | 'user'
  | 'calendar'
  | 'search'
  | 'folder'
  // Social platforms. Filled marks rather than outlines, because these are
  // brand marks and an outlined version of a logo reads as the wrong logo.
  | 'facebook'
  | 'instagram'
  | 'linkedin'
  | 'x'
  | 'youtube'
  | 'tiktok';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Decorative by default; pass a label when the icon carries meaning. */
  label?: string;
}

const { name, size = 20, class: className = '', label } = Astro.props;

const a11y = label
  ? ({ role: 'img' as const, 'aria-label': label } satisfies Record<string, unknown>)
  : ({ 'aria-hidden': 'true' as const, focusable: 'false' } satisfies Record<string, unknown>);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  class={className}
  {...a11y}
>
  {
    name === 'envelope' && (
      <>
        <rect
          x="2.5"
          y="4.5"
          width="19"
          height="15"
          rx="2"
          stroke="currentColor"
          stroke-width="1.8"
        />
        <path
          d="m3 7 8.4 5.6a1.5 1.5 0 0 0 1.7 0L21 7"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        />
      </>
    )
  }
  {
    name === 'phone' && (
      <path
        d="M6.5 3h3l1.5 4-2 1.4a12 12 0 0 0 5.6 5.6L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3.5 5.2 2 2 0 0 1 5.5 3Z"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linejoin="round"
      />
    )
  }
  {
    name === 'phone-landline' && (
      <>
        {/* Filled rather than stroked, unlike its neighbours.
            Three stroked attempts at a desk phone all read as something else at
            the sizes this is used (15px in the top bar, 20px elsewhere): a
            handbag, an iron, then a kitchen scale. A 1.8px outline cannot carry
            three shapes inside 24px. A solid silhouette survives, and the set
            already makes this trade for the social marks. */}
        {/* Handset: a thin bar, deliberately unlike the chunky base below, so
            the pair reads as two objects rather than one stacked box. */}
        <rect x="4" y="4" width="16" height="3.6" rx="1.8" fill="currentColor" />
        {/* Base, tapering out to the desk. */}
        <path
          d="M6 11h12a1.5 1.5 0 0 1 1.46 1.15l1.5 6.2A1.5 1.5 0 0 1 19.5 20.2h-15a1.5 1.5 0 0 1-1.46-1.85l1.5-6.2A1.5 1.5 0 0 1 6 11Z"
          fill="currentColor"
        />
      </>
    )
  }
  {
    name === 'map-pin' && (
      <>
        <path
          d="M20 10c0 5.5-8 12-8 12s-8-6.5-8-12a8 8 0 0 1 16 0Z"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"
        />
        <circle cx="12" cy="10" r="2.8" stroke="currentColor" stroke-width="1.8" />
      </>
    )
  }
  {
    name === 'whatsapp' && (
      <path
        fill="currentColor"
        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.24 8.24c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.13-1.05-.39-2-1.23a7.4 7.4 0 0 1-1.38-1.72c-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.09-.16.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.06s.89 2.39 1.01 2.56c.12.16 1.74 2.66 4.22 3.73.59.25 1.05.4 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z"
      />
    )
  }
  {
    name === 'arrow-up' && (
      <path
        d="M12 19V5m0 0-6 6m6-6 6 6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    )
  }
  {
    name === 'arrow-right' && (
      <path
        d="M5 12h14m0 0-6-6m6 6-6 6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    )
  }
  {
    name === 'chevron-right' && (
      <path
        d="m9 5 7 7-7 7"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    )
  }
  {
    name === 'menu' && (
      <path
        d="M3 6h18M3 12h18M3 18h18"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
    )
  }
  {
    name === 'close' && (
      <path
        d="M6 6l12 12M18 6L6 18"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
    )
  }
  {
    name === 'plus' && (
      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    )
  }
  {
    name === 'minus' && (
      <path d="M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    )
  }
  {
    name === 'user' && (
      <>
        <circle cx="12" cy="8" r="3.6" stroke="currentColor" stroke-width="1.8" />
        <path
          d="M4.5 20c.7-3.8 3.9-6 7.5-6s6.8 2.2 7.5 6"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        />
      </>
    )
  }
  {
    name === 'calendar' && (
      <>
        <rect
          x="3.5"
          y="5"
          width="17"
          height="16"
          rx="2"
          stroke="currentColor"
          stroke-width="1.8"
        />
        <path
          d="M3.5 10h17M8 3v4m8-4v4"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        />
      </>
    )
  }
  {
    name === 'search' && (
      <>
        <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8" />
        <path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </>
    )
  }
  {
    name === 'folder' && (
      <path
        d="M3.5 6.5A1.5 1.5 0 0 1 5 5h3.8l1.7 2.2H19a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 19 19H5a1.5 1.5 0 0 1-1.5-1.5Z"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linejoin="round"
      />
    )
  }
  {
    name === 'facebook' && (
      <path
        d="M14 8.5h2.2V5.6c-.4-.05-1.2-.1-2.1-.1-2.1 0-3.5 1.3-3.5 3.7V11H8.4v3.2h2.2V22h3.3v-7.8h2.3l.35-3.2h-2.65V9.6c0-.75.2-1.1 1.1-1.1Z"
        fill="currentColor"
      />
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8" />
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
        <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" />
      </>
    )
  }
  {
    name === 'linkedin' && (
      <path
        d="M4.5 9h3v10.5h-3V9Zm1.5-4.6a1.75 1.75 0 1 1 0 3.5 1.75 1.75 0 0 1 0-3.5ZM10 9h2.9v1.45h.04c.4-.76 1.4-1.56 2.88-1.56 3.08 0 3.65 2.03 3.65 4.66V19.5h-3v-5.05c0-1.2-.02-2.75-1.68-2.75-1.68 0-1.94 1.31-1.94 2.66v5.14H10V9Z"
        fill="currentColor"
      />
    )
  }
  {
    name === 'x' && (
      <path
        d="M17.3 3h3.2l-7 8 7.3 10h-5.6l-4.4-6-5 6H2.6l7.3-8.6L2.9 3h5.7l4.1 5.6L17.3 3Zm-1.1 16h1.7L7.6 4.7H5.8L16.2 19Z"
        fill="currentColor"
      />
    )
  }
  {
    name === 'youtube' && (
      <>
        <rect
          x="2.5"
          y="5.5"
          width="19"
          height="13"
          rx="3.5"
          stroke="currentColor"
          stroke-width="1.8"
        />
        <path d="M10.5 9.3v5.4l4.6-2.7-4.6-2.7Z" fill="currentColor" />
      </>
    )
  }
  {
    name === 'tiktok' && (
      <path
        d="M13.2 3h2.9c.15 1.4.95 2.6 2.1 3.25.6.35 1.3.55 2 .6v2.9a7.3 7.3 0 0 1-3.9-1.25v5.6a5.55 5.55 0 1 1-5.55-5.55c.3 0 .6.03.9.08v2.98a2.6 2.6 0 1 0 1.75 2.46V3Z"
        fill="currentColor"
      />
    )
  }
</svg>
