---
import Eyebrow from './Eyebrow.astro';

/**
 * Eyebrow + section title. Measured on the original:
 *   eyebrow 16px/500, 21px line box
 *   22px gap
 *   h2 60px/700 on a 70px line box
 */
export interface Props {
  eyebrow?: string;
  title: string;
  onDark?: boolean;
  align?: 'left' | 'center';
  /** Render as h1 where the section is the page's primary heading. */
  as?: 'h1' | 'h2';
  /**
   * Space between the eyebrow and the title. 22px on the About and services
   * sections, 7px in the FAQ — the original is not consistent, so this is a
   * per-section value rather than a single token.
   */
  gap?: number;
  class?: string;
  titleClass?: string;
  eyebrowClass?: string;
}

const {
  eyebrow,
  title,
  onDark = false,
  align = 'left',
  as: Tag = 'h2',
  gap = 22,
  class: className = '',
  titleClass = '',
  eyebrowClass = '',
} = Astro.props;
---

<div class:list={[align === 'center' && 'text-center', className]}>
  {
    eyebrow && (
      <Eyebrow onDark={onDark} class={eyebrowClass}>
        {eyebrow}
      </Eyebrow>
    )
  }
  <Tag
    class:list={['text-section font-bold', onDark ? 'text-white' : 'text-ink', titleClass]}
    style={eyebrow ? `margin-top:${gap}px` : undefined}
    set:html={title}
  />
</div>
