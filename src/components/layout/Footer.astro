---
import CmsImage from '../ui/CmsImage.astro';
import Icon from '../ui/Icon.astro';
import { getSite } from '../../data/get-site';
import logo from '../../assets/images/brand/logo-anchor.png';

const site = await getSite();

// The footer logo falls back to the header logo, which falls back to the local
// asset. Two levels because most sites use one mark in both places and should
// not have to upload it twice.
const footerLogo = site.brand.footerLogo ?? site.brand.logo ?? logo;

// The pitch is stored with blank lines between paragraphs, matching the
// original's <br><br>. Splitting here keeps that as content rather than markup.
const pitchParagraphs = site.footer.pitch
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean);

const SOCIAL_LABELS: Record<string, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  linkedin: 'LinkedIn',
  x: 'X',
  youtube: 'YouTube',
  tiktok: 'TikTok',
};

// Measured from the WordPress original at 1440px:
//   band 1  #084876, padding 80px / 10px
//     logo white box 234x99 with the wordmark at ~182x44 inside it
//     column headings 18px / 700 white
//     quick links 16px / 400 white on a 38px rhythm
//     contact items 18px / 400 white
//     buttons white bg, #084876 text, 15px / 700, padding 12px 24px, radius 5px
//   band 2  #084876, 71px, centred disclaimer
//   band 3  #1E1F21, 66px, credit left / legal links right
const year = new Date().getFullYear();
---

<footer class="mt-auto">
  <!-- Band 1: main footer -->
  <div class="bg-navy pt-[110px] pb-10 text-white">
    <div class="container-bs">
      <!-- Column origins measured on the original at 1440: 90 / 530 / 970.
           An 18px inset plus a 42px gap reproduces those exactly. -->
      <div class="grid gap-10 lg:grid-cols-3 lg:gap-[49px] lg:pl-[25px]">
        <!-- Column 1: logo + pitch -->
        <div>
          <!-- The white panel is part of the original design. It came from
               the logo PNG's own baked-in white padding; here it is explicit
               so the asset stays reusable on any background. -->
          <div class="w-fit bg-white px-[26px] py-[27px]">
            <CmsImage
              src={footerLogo}
              alt={`${site.name} logo`}
              class="h-auto w-[182px]"
              loading="lazy"
              width={182}
            />
          </div>

          <!-- The original is a single unstyled paragraph with a blank line
               between the question and the body — not a bold heading. The blank
               line is reproduced with a <br><br> so the paragraph stays one
               element, exactly as it was. -->
          <p class="mt-3.5 max-w-[380px] text-base leading-6 text-white">
            {
              pitchParagraphs.map((para, i) => (
                <>
                  {i > 0 && (
                    <>
                      <br />
                      <br />
                    </>
                  )}
                  {para}
                </>
              ))
            }
          </p>

          {
            site.social.length > 0 && (
              <ul class="mt-6 flex flex-wrap items-center gap-4">
                {site.social.map((profile) => (
                  <li>
                    <a
                      href={profile.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
                    >
                      <Icon
                        name={profile.platform}
                        size={20}
                        label={`${site.name} on ${SOCIAL_LABELS[profile.platform] ?? profile.platform}`}
                      />
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <!-- Column 2: quick links -->
        <div>
          <h2 class="text-lead leading-none font-bold text-white">{site.footer.linksTitle}</h2>
          <ul class="mt-[22px] space-y-[17px]">
            {
              site.footerLinks.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="block text-base leading-[21px] text-white/90 transition-colors hover:text-white hover:underline"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Column 3: contact -->
        <div>
          <h2 class="text-lead leading-none font-bold text-white">{site.footer.contactTitle}</h2>
          <ul class="mt-[20px] space-y-[7px]">
            <li>
              <a
                href={site.contact.address.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-lead flex gap-3 leading-[26px] text-white/90 transition-colors hover:text-white"
              >
                <Icon name="map-pin" size={20} class="mt-1 shrink-0" />
                <span>{site.contact.address.single}</span>
              </a>
            </li>
            <li>
              <a
                href={site.contact.phone.href}
                class="text-lead flex gap-3 leading-[26px] text-white/90 transition-colors hover:text-white"
              >
                <Icon name="phone" size={20} class="mt-1 shrink-0" />
                <span>{site.contact.phone.display}</span>
              </a>
            </li>
            <li>
              <a
                href={site.contact.email.href}
                class="text-lead flex gap-3 leading-[26px] break-all text-white/90 transition-colors hover:text-white"
              >
                <Icon name="envelope" size={20} class="mt-1 shrink-0" />
                <span>{site.contact.email.address}</span>
              </a>
            </li>
          </ul>

          <div class="mt-[30px] flex flex-wrap gap-3">
            {
              site.footer.buttons.map((button) =>
                button.action === 'dialog' ? (
                  <button
                    type="button"
                    data-dialog-open={button.dialog}
                    class="text-meta text-navy inline-flex items-center rounded-[5px] bg-white px-6 py-3 leading-[15px] font-bold transition-colors hover:bg-white/90"
                  >
                    {button.label}
                  </button>
                ) : (
                  <a
                    href={button.action === 'phone' ? site.contact.phone.href : button.href}
                    class="text-meta text-navy inline-flex items-center rounded-[5px] bg-white px-6 py-3 leading-[15px] font-bold transition-colors hover:bg-white/90"
                  >
                    {button.label}
                  </a>
                ),
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Band 2: financing disclaimer -->
  <div class="bg-navy flex min-h-[71px] items-center py-2.5">
    <div class="container-bs">
      <p class="text-center text-base leading-4 font-medium text-white">
        {site.disclaimers.footer}
      </p>
    </div>
  </div>

  <!-- Band 3: credit + legal -->
  <div class="bg-carbon py-2.5">
    <div class="container-bs">
      <div
        class="flex min-h-[46px] flex-wrap items-center justify-center gap-x-8 gap-y-1 text-center sm:justify-between sm:text-left"
      >
        <p class="text-carbon-text text-base">
          <a
            href={site.credit.href}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-carbon-link transition-colors hover:underline"
          >
            {site.credit.text}
          </a>
          {' '}&ndash; {year}
        </p>

        <ul class="flex items-center gap-6">
          {
            site.legalLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-carbon-link text-base transition-colors hover:text-white hover:underline"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</footer>
