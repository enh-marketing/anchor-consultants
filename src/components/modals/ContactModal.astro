---
import Dialog from './Dialog.astro';
import CmsForm from '../forms/CmsForm.astro';

// Replaces Popup Maker's pum-1979 ("contact-us"), which the original opens
// from "Lets Connect", "Get An Appointment" and "Free Consultation".
---

<Dialog
  id="contact-dialog"
  title="Contact Us"
  intro="Tell us what you need and we will come back with a clear next step."
>
  <CmsForm formId="contact" id="contact-modal-form" layout="modal" />
</Dialog>
