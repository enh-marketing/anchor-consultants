---
import Dialog from './Dialog.astro';
import CmsForm from '../forms/CmsForm.astro';

// Replaces Popup Maker's pum-1984 ("apply-for-job").
//
// The original asks only for a file, with no way to reply to the applicant and
// no restriction on type or size. The `cv` form definition adds a name and
// email and enforces PDF or Word up to 5 MB, on the client and on the server.
//
// The markup, styles and submit logic now come from `CmsForm`, which the
// contact form also uses. They were two near-identical copies of the same
// validation and status handling, which is how two forms end up behaving
// differently for no reason.
---

<Dialog id="cv-dialog" title="Upload Your CV" intro="PDF or Word document, up to 5 MB.">
  <CmsForm formId="cv" id="cv-form" layout="labelled" />
</Dialog>
