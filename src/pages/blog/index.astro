---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionRenderer from '../../components/sections/SectionRenderer.astro';
import PageBannerSection from '../../components/sections/PageBannerSection.astro';
import BlogIndexSection from '../../components/sections/BlogIndexSection.astro';
import { pageSections, pageSeo, pageCrumb } from '../../lib/page';
import { breadcrumbSchema } from '../../lib/seo';
import { SITE_URL } from '../../data/site-url.mjs';
import banner from '../../assets/images/banners/generic-2.jpg';

// Measured from the original at 1440:
//   left column 856 wide at x=72; sidebar 416 wide at x=952 (24px apart)
//
// Pagination is not reproduced: the original renders a pager even when it is
// empty, since two posts fit on one page. Worth adding once there is enough
// content to need it.
const sections = await pageSections('/blog/');
const seo = await pageSeo('/blog/', {
  title: 'Blog',
  description:
    'News, guidance and market notes from Anchor Consultants on mortgages, refinancing and property finance for buyers and investors in the UAE.',
});
const crumb = await pageCrumb('/blog/', 'Blog');
---

<PageLayout
  {...seo}
  schemas={[
    breadcrumbSchema([{ name: crumb, path: '/blog/' }]),
    {
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: 'Anchor Consultants Blog',
      url: new URL('/blog/', SITE_URL).href,
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
  ]}
>
  {
    sections.length ? (
      <SectionRenderer sections={sections} />
    ) : (
      <>
        <PageBannerSection title="Blog" crumb="Blog" image={banner} />
        <BlogIndexSection />
      </>
    )
  }
</PageLayout>
