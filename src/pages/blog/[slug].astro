---
import type { GetStaticPaths } from 'astro';
import CmsImage from '../../components/ui/CmsImage.astro';
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PageBanner from '../../components/shared/PageBanner.astro';
import PortableText from '../../components/shared/PortableText.astro';
import BlogSidebar from '../../components/blog/BlogSidebar.astro';
import Icon from '../../components/ui/Icon.astro';
import { breadcrumbSchema } from '../../lib/seo';
import { getSite } from '../../data/get-site';
import { postAuthor, postCategories, postTags, relatedPosts } from '../../lib/blog';
import PostCard from '../../components/blog/PostCard.astro';
import { SITE_URL } from '../../data/site-url.mjs';
import banner from '../../assets/images/banners/generic-2.jpg';

/**
 * Post template.
 *
 * Measured from the original `/dummy-blog/` at 1440:
 *   `.blog__details-left` 856 wide at x=72, 40px padding,
 *     `0 0 70px rgba(0,0,0,0.08)` shadow
 *   featured image 750x500, 30px below it
 *   meta row 30px above / 25px below, 30px bottom padding,
 *     1px #EDEDED rule underneath
 *   body 16px/26px #777
 *
 * The original follows the body with a WordPress comment form. It is not
 * carried over: a static build has nowhere to store comments, the site has
 * none, and a form that silently discards input would be worse than no form.
 * Flagged as Q14 in MIGRATION.md rather than decided unilaterally.
 */
export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
// The body is markdown when the content comes from `src/content/`, and
// Portable Text when it comes from Sanity. `render()` only understands the
// former, so it is only called when there is no Portable Text to render.
const portableBody = Array.isArray(post.data.body) ? post.data.body : null;
const Content = portableBody ? null : (await render(post)).Content;
const { title, excerpt, coverImage, coverImageAlt, publishedAt, updatedAt, seo } = post.data;

const site = await getSite();
const author = postAuthor(post.data.author, site.name);
const categories = postCategories(post.data);
const tags = postTags(post.data);

// Hand-picked related posts win. Otherwise they are suggested from shared tags
// and categories, so the section is useful without anyone maintaining it.
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const picked = post.data.relatedPosts ?? [];
const related = picked.length
  ? allPosts.filter((entry) => picked.some((r) => r.id === entry.id))
  : relatedPosts(post, allPosts);

const archived = new Set((await getCollection('categories')).map((entry) => entry.data.slug));
const categoryHref = (slug: string) =>
  archived.has(slug) ? `/blog/category/${slug}/` : `/blog/?category=${slug}`;

const dateFmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const url = new URL(`/blog/${post.id}/`, SITE_URL).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  datePublished: publishedAt.toISOString(),
  ...(updatedAt ? { dateModified: updatedAt.toISOString() } : {}),
  author: { '@type': 'Organization', name: author },
  publisher: { '@id': `${SITE_URL}/#organization` },
  mainEntityOfPage: url,
  url,
};
---

<PageLayout
  title={title}
  description={seo?.metaDescription ?? excerpt}
  path={`/blog/${post.id}/`}
  schemas={[
    breadcrumbSchema([
      { name: 'Blog', path: '/blog/' },
      { name: title, path: `/blog/${post.id}/` },
    ]),
    articleSchema,
  ]}
>
  <PageBanner title={title} crumb={title} image={banner} />

  <section class="py-[120px]">
    <!-- Bootstrap col-8 / col-4, as on the index. -->
    <div class="container-bs">
      <div class="-mx-3 grid gap-y-[30px] lg:grid-cols-[66.667%_33.333%]">
        <div class="min-w-0 px-3">
          <article class="post-body">
            {
              coverImage && (
                <CmsImage
                  src={coverImage}
                  alt={coverImageAlt ?? ''}
                  widths={[375, 750, 1500]}
                  sizes="(min-width: 1200px) 750px, 100vw"
                  class="mb-[30px] h-auto w-full max-w-[750px]"
                  loading="eager"
                />
              )
            }

            <p
              class="text-body border-line mt-[30px] mb-[25px] flex flex-wrap items-center gap-x-[34px] gap-y-1 border-b pb-[30px] text-base leading-[26px]"
            >
              <span class="flex items-center gap-2">
                <Icon name="user" size={16} class="shrink-0" />
                {author.name}
              </span>
              <span class="flex items-center gap-2">
                <Icon name="calendar" size={16} class="shrink-0" />
                <time datetime={publishedAt.toISOString()}>{dateFmt.format(publishedAt)}</time>
              </span>
              {
                updatedAt && (
                  <span class="flex items-center gap-2">
                    Updated{' '}
                    <time datetime={updatedAt.toISOString()}>{dateFmt.format(updatedAt)}</time>
                  </span>
                )
              }
              {
                categories.length > 0 && (
                  <span class="flex flex-wrap items-center gap-2">
                    <Icon name="folder" size={16} class="shrink-0" />
                    {categories.map((term, i) => (
                      <>
                        {i > 0 && <span aria-hidden="true">,</span>}
                        <a href={categoryHref(term.slug)} class="text-navy hover:underline">
                          {term.title}
                        </a>
                      </>
                    ))}
                  </span>
                )
              }
            </p>

            <div class="prose-body">
              {portableBody ? <PortableText value={portableBody} /> : Content && <Content />}
            </div>

            {
              tags.length > 0 && (
                <ul class="mt-[35px] flex flex-wrap items-center gap-2" aria-label="Tags">
                  {tags.map((term) => (
                    <li class="text-body bg-mist text-small rounded-full px-3 py-1 leading-[22px]">
                      {term.title}
                    </li>
                  ))}
                </ul>
              )
            }

            {
              (author.bio || author.photo) && (
                <div class="border-line mt-[35px] flex flex-wrap items-start gap-5 border-t pt-[30px]">
                  {author.photo && (
                    <CmsImage
                      src={author.photo}
                      alt=""
                      aria-hidden="true"
                      width={72}
                      class="h-[72px] w-[72px] shrink-0 rounded-full object-cover"
                      loading="lazy"
                    />
                  )}
                  <div class="min-w-0">
                    <p class="text-ink text-base leading-[26px] font-bold">{author.name}</p>
                    {author.role && (
                      <p class="text-body text-small leading-[22px]">{author.role}</p>
                    )}
                    {author.bio && (
                      <p class="text-body mt-2 text-base leading-[26px]">{author.bio}</p>
                    )}
                    {author.links.length > 0 && (
                      <ul class="mt-2 flex flex-wrap gap-4">
                        {author.links.map((link) => (
                          <li>
                            <a
                              href={link.href}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-navy text-small hover:underline"
                            >
                              {link.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              )
            }

            <p class="mt-[40px]">
              <a
                href="/blog/"
                class="text-navy inline-flex items-center gap-2 text-base font-medium hover:underline"
              >
                <Icon name="chevron-right" size={14} class="rotate-180" />
                Back to all posts
              </a>
            </p>
          </article>

          {
            related.length > 0 && (
              <section class="mt-[40px]" aria-labelledby="related-heading">
                <h2 id="related-heading" class="text-ink text-[24px] leading-[34px] font-bold">
                  Related reading
                </h2>
                <div class="mt-[30px] flex flex-col gap-[40px]">
                  {related.map((entry) => (
                    <PostCard post={entry} headingLevel={3} />
                  ))}
                </div>
              </section>
            )
          }
        </div>

        <div class="min-w-0 px-3">
          <BlogSidebar />
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .post-body {
    padding: 40px;
    background: #fff;
    box-shadow: 0 0 70px rgb(0 0 0 / 0.08);
  }
  @media (max-width: 767px) {
    .post-body {
      padding: 30px 25px;
    }
  }

  /* Body copy from markdown. The original renders 16px/26px #777. */
  .prose-body {
    font-size: 16px;
    line-height: 26px;
    color: var(--color-body);
    overflow-wrap: anywhere;
  }
  .prose-body :global(p) {
    margin-bottom: 26px;
  }
  .prose-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .prose-body :global(h2),
  .prose-body :global(h3),
  .prose-body :global(h4) {
    color: #1c1e22;
    font-weight: 700;
    margin: 34px 0 14px;
  }
  .prose-body :global(h2) {
    font-size: 26px;
    line-height: 36px;
  }
  .prose-body :global(h3) {
    font-size: 22px;
    line-height: 32px;
  }
  .prose-body :global(h4) {
    font-size: 18px;
    line-height: 28px;
  }
  .prose-body :global(ul),
  .prose-body :global(ol) {
    margin: 0 0 26px 20px;
  }
  .prose-body :global(ul) {
    list-style: disc;
  }
  .prose-body :global(ol) {
    list-style: decimal;
  }
  .prose-body :global(li) {
    margin-bottom: 8px;
  }
  .prose-body :global(a) {
    color: #084876;
    text-decoration: underline;
  }
  .prose-body :global(blockquote) {
    border-left: 3px solid #084876;
    padding-left: 20px;
    margin: 0 0 26px;
    font-style: italic;
  }
  .prose-body :global(img) {
    max-width: 100%;
    height: auto;
  }

  /* A figure needs the same vertical rhythm as a paragraph, or the caption and
     the copy that follows read as one run of text. */
  .prose-body :global(figure) {
    margin: 0 0 26px;
  }
  .prose-body :global(figcaption) {
    margin-top: 10px;
    font-size: 14px;
    line-height: 22px;
    color: var(--color-body);
  }
</style>
