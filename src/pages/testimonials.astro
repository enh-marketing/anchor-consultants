---
import PageLayout from '../layouts/PageLayout.astro';
import SectionRenderer from '../components/sections/SectionRenderer.astro';
import PageBannerSection from '../components/sections/PageBannerSection.astro';
import TestimonialGrid from '../components/sections/TestimonialGrid.astro';
import { pageSections, pageSeo, pageCrumb } from '../lib/page';
import { breadcrumbSchema } from '../lib/seo';
import banner from '../assets/images/banners/testimonials.jpg';

const sections = await pageSections('/testimonials/');
const seo = await pageSeo('/testimonials/', {
  title: 'Testimonials',
  description:
    'What clients across Dubai say about working with Anchor Consultants on mortgages, refinancing and property finance in the UAE.',
});
const crumb = await pageCrumb('/testimonials/', 'Testimonials');
---

<PageLayout {...seo} schemas={[breadcrumbSchema([{ name: crumb, path: '/testimonials/' }])]}>
  {
    sections.length ? (
      <SectionRenderer sections={sections} />
    ) : (
      <>
        <PageBannerSection title="Client Feedback" crumb="Testimonials" image={banner} />
        <TestimonialGrid />
      </>
    )
  }
</PageLayout>
