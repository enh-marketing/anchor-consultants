---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

// MILESTONE 00 SCAFFOLD ONLY.
// This page exists to prove the toolchain, tokens and fonts resolve.
// It is replaced by the real homepage at milestones 04, 05 and 07.

// `cls` uses a real Tailwind utility so each token is genuinely exercised
// by the compiler, rather than being faked with an inline hex.
const swatches = [
  { name: 'navy', hex: '#084876', cls: 'bg-navy', role: 'Primary — topbar, footer, buttons' },
  { name: 'azure', hex: '#2A78C0', cls: 'bg-azure', role: 'Highlighted service tile' },
  { name: 'ember', hex: '#E2762A', cls: 'bg-ember', role: 'Service card icons' },
  { name: 'teal', hex: '#0E6C90', cls: 'bg-teal', role: 'Accent' },
  { name: 'ink', hex: '#1C1E22', cls: 'bg-ink', role: 'Headings' },
  { name: 'body', hex: '#777777', cls: 'bg-body', role: 'Body copy — 363 elements' },
  { name: 'mist', hex: '#F7F7F7', cls: 'bg-mist', role: 'Alternating sections' },
  { name: 'carbon', hex: '#1E1F21', cls: 'bg-carbon', role: 'Copyright bar' },
];

const scale = [
  { token: 'text-hero', label: 'Hero H1', target: '80px' },
  { token: 'text-section', label: 'Section H2', target: '60px' },
  { token: 'text-display', label: 'Sub-heading', target: '30px' },
  { token: 'text-card', label: 'Card title', target: '24px' },
  { token: 'text-lead', label: 'Lead', target: '18px' },
  { token: 'text-base', label: 'Body', target: '16px / 26px' },
];
---

<BaseLayout
  description="Scaffold verification page for the Anchor Consultants Astro rebuild. Confirms design tokens, typography and the build pipeline resolve correctly."
  path="/"
  noindex
>
  <div class="container-bs py-16">
    <p class="mb-3 font-mono text-small tracking-[0.16em] text-navy uppercase">
      Milestone 00 · Scaffold
    </p>
    <h1 class="text-hero text-ink">{site.name}</h1>
    <p class="mt-4 max-w-[60ch] text-lead">
      Astro + Tailwind + GSAP toolchain verified. Design tokens below are read from
      computed styles on the live WordPress site. This page is replaced by the real
      homepage at milestone 04.
    </p>

    <section class="mt-14">
      <h2 class="text-display text-ink">Colour tokens</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          swatches.map((s) => (
            <div class="overflow-hidden rounded border border-line">
              <div class={`h-20 ${s.cls}`} data-token={s.name} />
              <div class="p-3">
                <p class="font-mono text-small text-ink">{s.name}</p>
                <p class="font-mono text-small text-body">{s.hex}</p>
                <p class="mt-1 text-small text-body">{s.role}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-display text-ink">Type scale — DM Sans</h2>
      <div class="mt-6 divide-y divide-line border-y border-line">
        {
          scale.map((t) => (
            <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1 py-4">
              <span class="w-40 shrink-0 font-mono text-small text-body">{t.token}</span>
              <span class={`text-ink ${t.token}`} style="font-weight:700">
                {t.label}
              </span>
              <span class="ml-auto font-mono text-small text-body">{t.target}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-display text-ink">Breakpoints — Bootstrap 5 aligned</h2>
      <p class="mt-2 max-w-[60ch]">
        Resize the window. The active breakpoint is highlighted, confirming the
        992px primary switch where the mobile nav will activate.
      </p>
      <div class="mt-6 flex flex-wrap gap-2 font-mono text-small">
        <span class="rounded bg-mist px-3 py-2 text-ink sm:bg-navy sm:text-white">
          base &lt; 576
        </span>
        <span class="rounded bg-mist px-3 py-2 text-ink md:bg-navy md:text-white">sm 576</span>
        <span class="rounded bg-mist px-3 py-2 text-ink lg:bg-navy lg:text-white">md 768</span>
        <span class="rounded bg-mist px-3 py-2 text-ink xl:bg-navy xl:text-white">lg 992</span>
        <span class="rounded bg-mist px-3 py-2 text-ink 2xl:bg-navy 2xl:text-white">xl 1200</span>
        <span class="rounded bg-mist px-3 py-2 text-ink">2xl 1400</span>
      </div>
    </section>
  </div>
</BaseLayout>
