---
import PageLayout from '../layouts/PageLayout.astro';
import SectionRenderer from '../components/sections/SectionRenderer.astro';
import PageBannerSection from '../components/sections/PageBannerSection.astro';
import MapEmbed from '../components/sections/MapEmbed.astro';
import ContactPanel from '../components/sections/ContactPanel.astro';
import { pageSections, pageSeo, pageCrumb } from '../lib/page';
import { breadcrumbSchema } from '../lib/seo';
import { SITE_URL } from '../data/site-url.mjs';
import banner from '../assets/images/banners/contact.jpg';

// The last page to go on the builder. It was held back through M17 because its
// form was the subject of M21; with the form now driven by a definition, the
// page has nothing left that needed hardcoding.
const sections = await pageSections('/contact/');
const seo = await pageSeo('/contact/', {
  title: 'Contact',
  description:
    'Talk to Anchor Consultants about mortgages, refinancing and property finance in the UAE. Office in Oud Metha, Dubai. Call, email or send us a question.',
});
const crumb = await pageCrumb('/contact/', 'Contact');

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Anchor Consultants',
  url: new URL('/contact/', SITE_URL).href,
  mainEntity: { '@id': `${SITE_URL}/#organization` },
};
---

<PageLayout
  {...seo}
  schemas={[breadcrumbSchema([{ name: crumb, path: '/contact/' }]), contactSchema]}
>
  {
    sections.length ? (
      <SectionRenderer sections={sections} />
    ) : (
      <>
        <PageBannerSection title="Get In Touch" crumb="Contact" image={banner} />
        <MapEmbed />
        <ContactPanel />
      </>
    )
  }
</PageLayout>
