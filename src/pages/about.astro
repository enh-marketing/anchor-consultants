---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import PageBanner from '../components/shared/PageBanner.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { breadcrumbSchema } from '../lib/seo';
import banner from '../assets/images/banners/about.jpg';
import aboutMain from '../assets/images/about/about-page.jpg';
import aboutInset from '../assets/images/about/split-1.jpg';
import plan from '../assets/images/about/plan.jpg';

// Measured from the original at 1440:
//   banner 226px, then section 1 at y=362 (818 tall, padding 110/100)
//     images: about.jpg 568x528 at x=70 (dy 120), about-1.jpg 420x420 at
//       x=220 (dy 288)
//     eyebrow dy 204, h2 dy 247 (60px/700, 70px line box, 640 wide)
//     body dy 487 (18px/400 #777, 28px line box, 666 wide)
//   section 2 at y=1180 (817 tall, padding 0/110)
//     plan.jpg 570x500 at x=800 (dy 10)
//     h2 dy 56 (650 wide), body dy 216 and dy 435 (16px/400, 26px line box)
---

<PageLayout
  title="About"
  description="Anchor Consultants is a UAE mortgage and property finance advisory built on deep banking experience, with access to multiple lenders across the Emirates."
  path="/about/"
  schemas={[breadcrumbSchema([{ name: 'About', path: '/about/' }])]}
>
  <PageBanner title="Who We Are" crumb="About" image={banner} />

  <!-- Who we are -->
  <section class="pt-[110px] pb-[100px]">
    <div class="mx-auto w-full max-w-[1320px] px-3 lg:px-[10px]">
      <div class="grid items-start gap-12 lg:grid-cols-[660px_640px] lg:justify-between lg:gap-0">
        <div class="reveal relative lg:h-[608px] lg:py-[10px]">
          <Image
            src={aboutMain}
            alt="The Anchor Consultants advisory team in discussion"
            class="h-auto w-full lg:h-[528px] lg:w-[568px] lg:object-cover"
            loading="eager"
            widths={[568, 1136]}
            sizes="(min-width: 992px) 568px, 100vw"
          />
          <Image
            src={aboutInset}
            alt="Advisers reviewing property financing options with a client"
            class="mt-4 h-auto w-[70%] lg:absolute lg:top-[178px] lg:left-[150px] lg:mt-0 lg:h-[420px] lg:w-[420px] lg:object-cover"
            loading="lazy"
            widths={[420, 840]}
            sizes="(min-width: 992px) 420px, 70vw"
          />
        </div>

        <div class="reveal lg:pt-[94px]" data-reveal-delay="0.1">
          <SectionHeading
            eyebrow="About Us"
            title="The Region’s Leading Business & Finance Consultancy"
          />
          <p class="text-body text-lead mt-[30px] max-w-[666px] leading-7">
            The Region&rsquo;s Leading Business &amp; Finance Consultancy With a foundation built on
            integrity and deep market insights, we bridge the gap between complex financial
            challenges and successful outcomes. We specialize in navigating the intricate landscapes
            of UAE real estate and global finance, ensuring our clients achieve sustainable wealth.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="pb-[110px]">
    <div class="mx-auto w-full max-w-[1320px] px-3 lg:px-[10px]">
      <div class="grid items-start gap-12 lg:grid-cols-[650px_570px] lg:justify-between lg:gap-0">
        <div class="reveal lg:pt-[56px] lg:pb-[90px]">
          <h2 class="text-section text-ink font-bold">Why Choose Anchor Consultants?</h2>

          <p class="text-body mt-[20px] max-w-[628px] text-base leading-[26px]">
            <b class="text-ink-strong">&bull; Trusted Mortgage Experts:</b> Years of experience in UAE
            banking, mortgage advisory, and property finance.<br />
            <b class="text-ink-strong">&bull; Access to Multiple Banks:</b> Compare mortgage offers from
            all leading UAE banks to find competitive rates.<br />
            <b class="text-ink-strong">&bull; Tailored Financing Solutions:</b> Personalized advice for
            first-time homebuyers, investors, and expats.<br />
            <b class="text-ink-strong">&bull; Transparent &amp; Efficient Process:</b> Clear guidance
            from application to loan approval.
          </p>

          <p class="text-body mt-[11px] max-w-[624px] text-base leading-[26px]">
            At <b class="text-ink-strong">Anchor Consultants</b>, we simplify the complex mortgage
            process and empower you with the knowledge and support you need to make
            <b class="text-ink-strong">confident property financing decisions.</b><br /><br />
            <b class="text-ink-strong">Contact us today</b> to explore the best
            <b class="text-ink-strong">
              mortgage solutions in Dubai, Abu Dhabi, and across the UAE</b
            >, and secure your ideal home or investment property with expert guidance.
          </p>
        </div>

        <div class="reveal lg:pt-[10px]" data-reveal-delay="0.1">
          <Image
            src={plan}
            alt="Anchor advisers planning a client's financing route"
            class="h-auto w-full lg:h-[500px] lg:w-[570px] lg:object-cover"
            loading="lazy"
            widths={[570, 1140]}
            sizes="(min-width: 992px) 570px, 100vw"
          />
        </div>
      </div>
    </div>
  </section>
</PageLayout>
