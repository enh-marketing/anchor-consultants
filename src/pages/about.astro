---
import PageLayout from '../layouts/PageLayout.astro';
import SectionRenderer from '../components/sections/SectionRenderer.astro';
import PageBannerSection from '../components/sections/PageBannerSection.astro';
import AboutIntro from '../components/sections/AboutIntro.astro';
import CopyWithImage from '../components/sections/CopyWithImage.astro';
import { pageSections, pageDescription } from '../lib/page';
import { breadcrumbSchema } from '../lib/seo';
import banner from '../assets/images/banners/about.jpg';

// Sections come from the `page` document with slug `/about/` when one exists.
// The fixed order below is the fallback and the reference the CMS output is
// verified against, exactly as on the home page.
const sections = await pageSections('/about/');
const description = await pageDescription(
  '/about/',
  'Anchor Consultants is a UAE mortgage and property finance advisory built on deep banking experience, with access to multiple lenders across the Emirates.',
);
---

<PageLayout
  title="About"
  description={description}
  path="/about/"
  schemas={[breadcrumbSchema([{ name: 'About', path: '/about/' }])]}
>
  {
    sections.length ? (
      <SectionRenderer sections={sections} />
    ) : (
      <>
        <PageBannerSection title="Who We Are" crumb="About" image={banner} />
        <AboutIntro />
        <CopyWithImage />
      </>
    )
  }
</PageLayout>
