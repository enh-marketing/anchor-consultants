---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import PageBanner from '../../components/shared/PageBanner.astro';
import Button from '../../components/ui/Button.astro';
import { breadcrumbSchema } from '../../lib/seo';
import { SITE_URL } from '../../data/site-url.mjs';
import genericBanner from '../../assets/images/banners/generic-1.jpg';

// Measured from the original at 1440:
//   banner 226px, hero 1290x670 at x=75 (120px below the banner)
//   "Description:" 24px/700 on a 24px line box at x=82, 50px below the hero
//   body 16px/400 #777 on a 26px line box, 967 wide
//   feature cards 312x94, 1px #EDEDED, rgba(240,240,240,0.1), padding 20px 30px,
//     icon ~52px then a 16px/700 title
//   checklist items on a 39px rhythm, 16px/400 #777, custom check marker
//
// These four pages 404'd until the client reset permalinks (audit defect #1).
// The template varies per service: Lease Rental Discounting has neither
// feature cards nor a checklist (defect #24), so both are optional.
//
// A closing CTA is added per Q12 — the original ends abruptly on the
// checklist with nothing asking the reader to act.

export const getStaticPaths: GetStaticPaths = async () => {
  const services = await getCollection('services');
  return services
    .filter((s) => !s.data.draft)
    .map((service) => ({ params: { slug: service.id }, props: { service } }));
};

export interface Props {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const { Content } = await render(service);
const d = service.data;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.title,
  description: d.summary,
  serviceType: d.title,
  areaServed: { '@type': 'Country', name: 'United Arab Emirates' },
  provider: { '@id': `${SITE_URL}/#organization` },
  url: new URL(`/services/${service.id}/`, SITE_URL).href,
};
---

<PageLayout
  title={d.title}
  description={d.seo?.metaDescription ?? d.summary}
  path={`/services/${service.id}/`}
  schemas={[
    breadcrumbSchema([
      { name: 'Services', path: '/services/' },
      { name: d.title, path: `/services/${service.id}/` },
    ]),
    serviceSchema,
  ]}
>
  <PageBanner title={d.title} crumb={d.title} image={d.bannerImage ?? genericBanner} />

  <article class="pt-[120px] pb-[110px]">
    <!-- Hero -->
    {
      d.heroImage && (
        <div class="reveal mx-auto w-full max-w-[1290px] px-3 lg:px-0">
          <Image
            src={d.heroImage}
            alt={`${d.title} at Anchor Consultants`}
            class="h-auto w-full lg:h-[670px] lg:object-cover"
            loading="eager"
            fetchpriority="high"
            widths={[760, 1290, 2580]}
            sizes="(min-width: 1320px) 1290px, 100vw"
          />
        </div>
      )
    }

    <div class="mx-auto w-full max-w-[1290px] px-3 lg:px-0">
      <div class="lg:pl-[7px]">
        <!-- Description -->
        <div class="reveal mt-[50px] max-w-[980px]">
          <h2 class="text-ink text-[24px] leading-[24px] font-bold">Description:</h2>
          <div class="service-body text-body mt-[20px] text-base leading-[26px]">
            <Content />
          </div>
        </div>

        <!-- Feature cards -->
        {
          d.features && d.features.length > 0 && (
            <ul class="reveal mt-[10px] grid max-w-[967px] list-none gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {d.features.map((feature) => (
                <li class="flex min-h-[94px] items-center gap-[25px] border border-[#ededed] bg-[rgba(240,240,240,0.1)] px-[30px] py-[20px]">
                  {feature.icon && (
                    <Image
                      src={feature.icon}
                      alt=""
                      aria-hidden="true"
                      class="h-[52px] w-[52px] shrink-0 object-contain"
                      loading="lazy"
                      densities={[1, 2]}
                    />
                  )}
                  <h3 class="text-ink text-base leading-[26px] font-bold">{feature.title}</h3>
                </li>
              ))}
            </ul>
          )
        }

        <!-- Checklist -->
        {
          d.checklist && d.checklist.length > 0 && (
            <ul class="reveal mt-[37px] max-w-[967px] list-none">
              {d.checklist.map((item) => (
                <li class="text-body flex items-start gap-[15px] pb-[13px] text-base leading-[26px]">
                  <svg
                    class="text-navy mt-[3px] h-[16px] w-[16px] shrink-0"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.7-9.3a1 1 0 0 0-1.4-1.4L9 10.58l-1.3-1.3a1 1 0 0 0-1.4 1.42l2 2a1 1 0 0 0 1.4 0l4-4Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )
        }

        <!-- Closing CTA (Q12). The original stops at the checklist. -->
        <div
          class="reveal bg-mist mt-[60px] flex max-w-[967px] flex-col items-start gap-6 p-[40px] sm:flex-row sm:items-center sm:justify-between"
        >
          <div>
            <h2 class="text-ink text-[24px] leading-[32px] font-bold">
              Ready to talk through {d.title.toLowerCase()}?
            </h2>
            <p class="text-body mt-2 max-w-[52ch] text-base leading-[26px]">
              Tell us your property type, timeline and borrower profile. We&rsquo;ll come back with
              a clear next step and the most suitable lender pathways.
            </p>
          </div>
          <Button href="/contact/" class="shrink-0">Book a Free Consultation</Button>
        </div>
      </div>
    </div>
  </article>
</PageLayout>

<style is:global>
  /* Body copy comes from markdown, so paragraph rhythm is set here. */
  .service-body p + p {
    margin-top: 26px;
  }
</style>
