---
import PageLayout from '../layouts/PageLayout.astro';
import SectionRenderer from '../components/sections/SectionRenderer.astro';
import PageBannerSection from '../components/sections/PageBannerSection.astro';
import ErrorPanel from '../components/sections/ErrorPanel.astro';
import { pageSections, pageDescription } from '../lib/page';
import banner from '../assets/images/banners/generic-1.jpg';

/**
 * 404.
 *
 * Stays its own route rather than going through `[...slug]`: Astro resolves the
 * not-found page from `src/pages/404.astro` specifically, and a catch-all
 * cannot take its place.
 *
 * The page is `noindex` and that stays in code. An editable 404 that could be
 * made indexable would be a genuine SEO problem.
 */
const sections = await pageSections('/404/');
const description = await pageDescription(
  '/404/',
  'The page you were looking for could not be found. Browse our UAE mortgage and property finance services, or get in touch and we will help.',
);
---

<PageLayout title="Page not found" description={description} path="/404/" noindex>
  {
    sections.length ? (
      <SectionRenderer sections={sections} />
    ) : (
      <>
        <PageBannerSection title="Not Found" crumb="Not Found" image={banner} />
        <ErrorPanel />
      </>
    )
  }
</PageLayout>
