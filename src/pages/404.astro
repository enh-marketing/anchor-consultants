---
import PageLayout from '../layouts/PageLayout.astro';
import PageBanner from '../components/shared/PageBanner.astro';
import banner from '../assets/images/banners/generic-1.jpg';

/**
 * 404.
 *
 * Measured from the original at 1440:
 *   banner 226px with h1 "Not Found" and a Home breadcrumb — hidden by
 *     defect #2, so it renders as an empty grey band. Restored here per Q1.
 *   `.error section-padding`, 120px 0, container 1320 at x=60
 *   "404" 300px/700 on a 285px line box, #1C1E22, centred at y=482
 *   subhead 30px/400/40px at y=767
 *   "Back to Home" 175x60, centred, at y=857
 *
 * The layout is reproduced. The copy is not: the original's subhead reads
 * "We will get back to you as soon as possible.", which belongs on a form
 * confirmation rather than a missing page. Logged as defect #28.
 *
 * The big "404" is decorative — the accessible page title is the banner h1 —
 * so it is an aria-hidden <p>, not a heading. 300px type overflows a phone,
 * so it steps down below the original's desktop size.
 */
---

<PageLayout
  title="Page not found"
  description="The page you were looking for could not be found. Browse our services or get in touch with Anchor Consultants."
  path="/404/"
  noindex
>
  <PageBanner title="Not Found" crumb="Not Found" image={banner} />

  <section class="py-[120px]">
    <div class="mx-auto w-full max-w-[1320px] px-3 text-center">
      <p
        class="text-ink text-[110px] leading-[1] font-bold sm:text-[180px] lg:text-[300px] lg:leading-[285px]"
        aria-hidden="true"
      >
        404
      </p>

      <h2 class="text-ink text-[24px] leading-[34px] font-normal lg:text-[30px] lg:leading-[40px]">
        We couldn&rsquo;t find that page.
      </h2>

      <p class="text-body mx-auto mt-4 max-w-[560px] text-base leading-[26px]">
        The link may be out of date, or the page may have moved. Try our
        <a href="/services/" class="text-navy underline">services</a> pages, or
        <a href="/contact/" class="text-navy underline">get in touch</a> and we will point you the right
        way.
      </p>

      <div class="mt-[50px]">
        <a
          href="/"
          class="bg-navy hover:bg-navy-600 inline-flex h-[60px] items-center rounded-[3px] px-[35px] text-base font-medium text-white transition-colors"
        >
          Back to Home
        </a>
      </div>
    </div>
  </section>
</PageLayout>
