---
import PageLayout from '../layouts/PageLayout.astro';
import SectionRenderer from '../components/sections/SectionRenderer.astro';
import PageBannerSection from '../components/sections/PageBannerSection.astro';
import { getSite } from '../data/get-site';
import { pageSections, pageSeo } from '../lib/page';
import { breadcrumbSchema } from '../lib/seo';
import banner from '../assets/images/banners/generic-3.jpg';

const site = await getSite();

// This page is the one most likely to be replaced wholesale, since it is
// waiting on legal text. Its shipped markup is kept as the fallback because the
// holding copy uses per-element spacing a generic prose rhythm cannot match;
// once real text arrives through the CMS, `.cms-prose` governs it.
//
// Indexing follows the same switch. While this is the holding page it must stay
// out of search results: it says the policy is being finalised, and a search
// result promising a privacy policy that does not exist is worse than none. Once
// a `page` document supplies real text, the page becomes indexable like any
// other and its SEO tab controls it — including hiding it again if wanted.
//
// Hardcoding `noindex` here would have made publishing the legal text look like
// it worked while leaving the page invisible, with nothing to say so.
const pageBlocks = await pageSections('/privacy-policy/');
const isHoldingPage = pageBlocks.length === 0;
const seo = await pageSeo('/privacy-policy/', {
  title: 'Privacy Policy',
  description:
    'How Anchor Consultants handles personal data. Our full privacy policy is being finalised; contact us in the meantime with any privacy enquiry.',
});

/** What the finished policy has to cover. Listed on the holding page. */
const sections = [
  'Who we are, and how to contact us about privacy',
  'What personal data we collect, and why',
  'The lawful basis for processing, and how long data is kept',
  'Who data is shared with, including lenders and service providers',
  'Cookies and analytics',
  'Your rights, and how to exercise them',
  'How to make a complaint',
];
---

<PageLayout
  {...seo}
  noindex={isHoldingPage}
  schemas={[breadcrumbSchema([{ name: 'Privacy Policy', path: '/privacy-policy/' }])]}
>
  {
    pageBlocks.length ? (
      <SectionRenderer sections={pageBlocks} />
    ) : (
      <>
        <PageBannerSection title="Privacy Policy" crumb="Privacy Policy" image={banner} />

        <section class="py-[120px]">
          <div class="mx-auto w-full max-w-[860px] px-3">
            <div class="border-navy bg-mist border-l-4 p-6">
              <h2 class="text-ink text-[22px] leading-[32px] font-bold">
                This policy is being finalised
              </h2>
              <p class="text-body mt-3 text-base leading-[26px]">
                We are preparing our full privacy policy. Until it is published, we are happy to
                answer any question about how we handle your personal data. Contact us and we will
                respond directly.
              </p>
            </div>

            <h2 class="text-ink mt-[50px] text-[26px] leading-[36px] font-bold">
              What the policy will cover
            </h2>
            <ul class="text-body mt-5 list-disc space-y-2 pl-5 text-base leading-[26px]">
              {sections.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            <h2 class="text-ink mt-[50px] text-[26px] leading-[36px] font-bold">
              Privacy enquiries
            </h2>
            <p class="text-body mt-4 text-base leading-[26px]">
              Write to us at{' '}
              <a href={site.contact.email.href} class="text-navy underline">
                {site.contact.email.address}
              </a>{' '}
              or call{' '}
              <a href={site.contact.phone.href} class="text-navy underline">
                {site.contact.phone.display}
              </a>
              . Our office is at {site.contact.address.single}.
            </p>

            <p class="text-body mt-[50px] text-base leading-[26px]">
              <a href="/contact/" class="text-navy underline">
                Get in touch
              </a>{' '}
              with any question about your data.
            </p>
          </div>
        </section>
      </>
    )
  }
</PageLayout>
