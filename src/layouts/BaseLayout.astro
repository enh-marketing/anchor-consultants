---
import '../styles/global.css';
import { resolveSeo, organizationSchema, type SeoInput } from '../lib/seo';
import { getSite } from '../data/get-site';

interface Props extends SeoInput {
  /** Extra JSON-LD graphs to emit alongside the Organization/WebSite graph. */
  schemas?: unknown[];
  bodyClass?: string;
}

const { schemas = [], bodyClass = '', ...seoInput } = Astro.props;
const site = await getSite();
const seo = resolveSeo(seoInput, site);
const graphs = [organizationSchema(site), ...schemas];
---

<!doctype html>
<html lang="en-AE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    <meta name="robots" content={seo.robots} />

    <meta property="og:type" content={seo.type} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:locale" content="en_AE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />

    {seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
    {seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      graphs.map((graph) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
      ))
    }

    {
      /* Marks JS as available before first paint, so scroll-reveal start
        states apply without a flash. If this never runs, content stays
        visible — the failure mode the WordPress build gets wrong. */
    }
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class={bodyClass}>
    <a
      href="#main"
      class="sr-only-focusable bg-navy absolute top-4 left-4 z-[100] rounded px-4 py-2 text-white"
    >
      Skip to content
    </a>

    <slot name="header" />

    <!-- tabindex="-1" so the skip link actually moves focus here. Without it
         browsers only move the sequential-navigation starting point, which is
         inconsistent and silently does nothing in some assistive tech. -->
    <main id="main" tabindex="-1" class="flex-1">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>
