# build output
dist/

# Vercel build output. Generated by `npm run build`; never committed.
.vercel/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Raw WordPress media drop zone (not shipped)
_incoming/

# Chrome for Testing, installed locally for Lighthouse runs. Never committed.
chrome/

# Sanity Studio build output and local install
studio/node_modules/
studio/dist/
studio/.sanity/

# Added by `vercel link`. `.vercel/` was already ignored above; the env rule is
# narrowed so `.env.example` stays tracked — it is the template that documents
# every variable, and ignoring it would mean a fresh clone had no record of them.
.env*
!.env.example
